{
  "openapi": "3.0.0",
  "info": {
    "title": "Expanse Tracker API",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:8000"
    }
  ],
  "paths": {
    "/api/signup": {
      "post": {
        "tags": ["Authentication"],
        "summary": "Register",
