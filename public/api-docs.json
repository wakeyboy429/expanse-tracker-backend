          "201": {
            "description": "Created"
          }
        }
      }
    },
    "/api/login": {
      "post": {
        "tags": ["Authentication"],
        "summary": "Login",
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    }
  }
}
